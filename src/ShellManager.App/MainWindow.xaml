<Window
    x:Class="ShellManager.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Shell Studio">

    <Grid x:Name="RootGrid">
        <NavigationView
            x:Name="Navigation"
            IsBackButtonVisible="Collapsed"
            IsSettingsVisible="False"
            IsPaneToggleButtonVisible="False"
            IsTitleBarAutoPaddingEnabled="True"
            PaneDisplayMode="Left"
            OpenPaneLength="238"
            SelectionChanged="Navigation_SelectionChanged">

            <NavigationView.PaneHeader>
                <StackPanel Orientation="Horizontal" Spacing="12" Margin="4,8,0,18">
                    <Border Width="38" Height="38" CornerRadius="10" Background="{StaticResource AccentBrush}">
                        <TextBlock Text="S" Foreground="White" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Shell Studio" FontSize="17" FontWeight="SemiBold" />
                        <TextBlock Text="上下文菜单管理器" Style="{StaticResource MutedTextStyle}" FontSize="11" />
                    </StackPanel>
                </StackPanel>
            </NavigationView.PaneHeader>

            <NavigationView.MenuItems>
                <NavigationViewItem Content="概览" Tag="Overview" IsSelected="True"><NavigationViewItem.Icon><FontIcon Glyph="&#xE80F;" /></NavigationViewItem.Icon></NavigationViewItem>
                <NavigationViewItem Content="菜单管理" Tag="Menus"><NavigationViewItem.Icon><FontIcon Glyph="&#xE8FD;" /></NavigationViewItem.Icon></NavigationViewItem>
                <NavigationViewItem Content="外观主题" Tag="Appearance"><NavigationViewItem.Icon><FontIcon Glyph="&#xE771;" /></NavigationViewItem.Icon></NavigationViewItem>
                <NavigationViewItem Content="配置源码" Tag="Source"><NavigationViewItem.Icon><FontIcon Glyph="&#xE943;" /></NavigationViewItem.Icon></NavigationViewItem>
                <NavigationViewItem Content="备份记录" Tag="Backups"><NavigationViewItem.Icon><FontIcon Glyph="&#xE81C;" /></NavigationViewItem.Icon></NavigationViewItem>
            </NavigationView.MenuItems>

            <NavigationView.PaneFooter>
                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8" Padding="12" Margin="2,8,2,12">
                    <StackPanel Spacing="4">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Ellipse x:Name="SidebarStatusDot" Width="8" Height="8" Fill="{StaticResource SuccessBrush}" />
                            <TextBlock x:Name="SidebarStatus" Text="正在检测 Shell…" FontWeight="SemiBold" FontSize="12" />
                        </StackPanel>
                        <TextBlock x:Name="SidebarVersion" Style="{StaticResource MutedTextStyle}" FontSize="11" Margin="16,0,0,0" />
                    </StackPanel>
                </Border>
            </NavigationView.PaneFooter>

            <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
                <Grid.RowDefinitions><RowDefinition Height="80" /><RowDefinition Height="*" /></Grid.RowDefinitions>

                <Grid Grid.Row="0" Padding="30,0,30,0">
                    <TextBlock x:Name="PageTitle" Text="概览" Style="{StaticResource PageTitleStyle}" VerticalAlignment="Center" />
                    <StackPanel Orientation="Horizontal" Spacing="9" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Border x:Name="UnsavedBadge" Visibility="Collapsed" Background="#26F59E0B" CornerRadius="12" Padding="10,5">
                            <TextBlock Text="有未保存更改" Foreground="#B56A00" FontSize="12" />
                        </Border>
                        <Button Content="保存" Click="Save_Click" />
                        <Button Content="保存并应用" Style="{StaticResource AccentButtonStyle}" Click="Apply_Click" />
                    </StackPanel>
                </Grid>

                <Grid Grid.Row="1" Padding="30,0,30,30">
                    <ScrollViewer x:Name="OverviewPage" VerticalScrollBarVisibility="Auto">
                        <StackPanel Spacing="18">
                            <Border Background="#17162B" CornerRadius="16" Padding="28">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <StackPanel Spacing="8">
                                        <TextBlock Text="配置中心" Foreground="White" FontSize="28" FontWeight="SemiBold" />
                                        <TextBlock Text="用安全、直观的方式管理 Windows 上下文菜单。" Foreground="#C9C7E8" FontSize="14" />
                                        <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,18,0,0">
                                            <Button Content="开始管理菜单" Style="{StaticResource AccentButtonStyle}" Click="OpenMenus_Click" />
                                            <Button Content="查看配置源码" Click="OpenSource_Click" />
                                        </StackPanel>
                                    </StackPanel>
                                    <FontIcon Grid.Column="1" Glyph="&#xE8FD;" FontSize="82" Foreground="#7770DD" Margin="40,0,22,0" />
                                </Grid>
                            </Border>

                            <Grid ColumnSpacing="14">
                                <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Style="{StaticResource CardStyle}"><StackPanel Spacing="8"><TextBlock Text="配置文件" Style="{StaticResource MutedTextStyle}" /><TextBlock x:Name="FileCount" Text="—" FontSize="32" FontWeight="SemiBold" /><TextBlock Text="主文件与导入模块" Style="{StaticResource MutedTextStyle}" FontSize="12" /></StackPanel></Border>
                                <Border Grid.Column="1" Style="{StaticResource CardStyle}"><StackPanel Spacing="8"><TextBlock Text="菜单结构" Style="{StaticResource MutedTextStyle}" /><TextBlock x:Name="NodeCount" Text="—" FontSize="32" FontWeight="SemiBold" /><TextBlock Text="菜单项、子菜单与规则" Style="{StaticResource MutedTextStyle}" FontSize="12" /></StackPanel></Border>
                                <Border Grid.Column="2" Style="{StaticResource CardStyle}"><StackPanel Spacing="8"><TextBlock Text="语法状态" Style="{StaticResource MutedTextStyle}" /><TextBlock x:Name="ValidationSummary" Text="—" FontSize="21" FontWeight="SemiBold" /><TextBlock Text="保存前自动检查" Style="{StaticResource MutedTextStyle}" FontSize="12" /></StackPanel></Border>
                            </Grid>

                            <Border Style="{StaticResource CardStyle}">
                                <Grid ColumnSpacing="24">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="180" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <StackPanel Spacing="4"><TextBlock Text="当前配置" FontSize="16" FontWeight="SemiBold" /><TextBlock Text="实时读取本机安装" Style="{StaticResource MutedTextStyle}" FontSize="12" /></StackPanel>
                                    <StackPanel Grid.Column="1" Spacing="6"><TextBlock x:Name="ConfigPathText" TextWrapping="Wrap" /><TextBlock x:Name="InstallPathText" Style="{StaticResource MutedTextStyle}" FontSize="12" /></StackPanel>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <Grid x:Name="MenusPage" Visibility="Collapsed" ColumnSpacing="14">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="340" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <Border Style="{StaticResource CardStyle}" Padding="10">
                            <Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                                <StackPanel Padding="12,10,12,12" Spacing="4"><TextBlock Text="配置结构" Style="{StaticResource SectionTitleStyle}" /><TextBlock Text="解析真实 NSS 并保留高级表达式" Style="{StaticResource MutedTextStyle}" FontSize="12" /></StackPanel>
                                <TreeView x:Name="OutlineTree" Grid.Row="1" SelectionMode="Single" SelectionChanged="OutlineTree_SelectionChanged">
                                    <TreeView.ItemTemplate><DataTemplate><StackPanel Orientation="Horizontal" Spacing="8"><Border Background="{StaticResource AccentSoftBrush}" CornerRadius="5" Padding="6,2"><TextBlock Text="{Binding Kind}" Foreground="{StaticResource AccentBrush}" FontSize="11" /></Border><TextBlock Text="{Binding Title}" /><TextBlock Text="{Binding Line}" Style="{StaticResource MutedTextStyle}" FontSize="11" /></StackPanel></DataTemplate></TreeView.ItemTemplate>
                                </TreeView>
                            </Grid>
                        </Border>
                        <Border Grid.Column="1" Style="{StaticResource CardStyle}">
                            <ScrollViewer><StackPanel Spacing="12"><TextBlock Text="快速添加" Style="{StaticResource SectionTitleStyle}" /><TextBlock Text="新增内容写入独立模块，不重排或覆盖现有配置。" Style="{StaticResource MutedTextStyle}" Margin="0,0,0,8" /><TextBlock Text="显示名称" FontWeight="SemiBold" /><TextBox x:Name="NewTitle" PlaceholderText="例如：用 VS Code 打开" /><TextBlock Text="执行程序或命令" FontWeight="SemiBold" /><TextBox x:Name="NewCommand" PlaceholderText="例如：code" /><TextBlock Text="参数" FontWeight="SemiBold" /><TextBox x:Name="NewArguments" Text="&quot;@sel.path&quot;" /><TextBlock Text="显示位置" FontWeight="SemiBold" /><ComboBox x:Name="NewType" SelectedIndex="0" HorizontalAlignment="Stretch"><ComboBoxItem Content="文件和文件夹" Tag="file|dir" /><ComboBoxItem Content="仅文件" Tag="file" /><ComboBoxItem Content="仅文件夹" Tag="dir" /><ComboBoxItem Content="目录空白处" Tag="back" /><ComboBoxItem Content="所有对象" Tag="*" /></ComboBox><ToggleSwitch x:Name="NewAdmin" Header="管理员权限" OffContent="普通运行" OnContent="以管理员身份运行" /><Button Content="添加菜单项" Style="{StaticResource AccentButtonStyle}" HorizontalAlignment="Left" Click="AddItem_Click" /><InfoBar IsOpen="True" IsClosable="False" Severity="Informational" Message="复杂的 where、find、image、invoke 等属性，可在配置源码中继续编辑。" /></StackPanel></ScrollViewer>
                        </Border>
                    </Grid>

                    <Grid x:Name="AppearancePage" Visibility="Collapsed" ColumnSpacing="18">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="370" /></Grid.ColumnDefinitions>
                        <Border Style="{StaticResource CardStyle}"><StackPanel Spacing="12"><TextBlock Text="主题预设" Style="{StaticResource SectionTitleStyle}" /><TextBlock Text="生成官方 theme{} 语法，可随时切换或继续微调。" Style="{StaticResource MutedTextStyle}" Margin="0,0,0,8" /><TextBlock Text="风格" FontWeight="SemiBold" /><ComboBox x:Name="ThemeName" SelectedIndex="0" HorizontalAlignment="Stretch"><ComboBoxItem Content="现代 · Modern" Tag="modern" /><ComboBoxItem Content="经典 · Classic" Tag="classic" /><ComboBoxItem Content="明亮 · White" Tag="white" /><ComboBoxItem Content="深色 · Black" Tag="black" /><ComboBoxItem Content="自动 · Auto" Tag="auto" /></ComboBox><TextBlock Text="密度" FontWeight="SemiBold" /><ComboBox x:Name="ThemeView" SelectedIndex="0" HorizontalAlignment="Stretch"><ComboBoxItem Content="紧凑" Tag="compact" /><ComboBoxItem Content="小" Tag="small" /><ComboBoxItem Content="中等" Tag="medium" /><ComboBoxItem Content="大" Tag="large" /><ComboBoxItem Content="宽" Tag="wide" /></ComboBox><NumberBox x:Name="ThemeRadius" Header="圆角" Minimum="0" Maximum="3" Value="2" SpinButtonPlacementMode="Inline" /><ToggleSwitch x:Name="ThemeShadow" Header="菜单阴影" IsOn="True" /><Button Content="生成主题配置" Style="{StaticResource AccentButtonStyle}" HorizontalAlignment="Left" Click="GenerateTheme_Click" /></StackPanel></Border>
                        <Border Grid.Column="1" Background="#25242B" CornerRadius="16" Padding="22" VerticalAlignment="Top"><StackPanel Spacing="12"><TextBlock Text="菜单预览" Foreground="#B8B6C2" FontSize="12" /><Border Background="#34323B" CornerRadius="10" Padding="8"><StackPanel Spacing="4"><Border Background="#675CF5" CornerRadius="6" Padding="12,9"><TextBlock Text="在 Shell Studio 中打开" Foreground="White" /></Border><TextBlock Text="复制路径" Foreground="White" Padding="12,9" /><TextBlock Text="使用终端打开" Foreground="White" Padding="12,9" /><Rectangle Height="1" Fill="#56535F" Margin="8,2" /><TextBlock Text="更多选项" Foreground="White" Padding="12,9" /></StackPanel></Border></StackPanel></Border>
                    </Grid>

                    <Grid x:Name="SourcePage" Visibility="Collapsed" ColumnSpacing="12">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="250" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <Border Style="{StaticResource CardStyle}" Padding="8"><ListView x:Name="FileList" SelectionChanged="FileList_SelectionChanged"><ListView.ItemTemplate><DataTemplate><StackPanel Padding="6" Spacing="3"><TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" /><TextBlock Text="{Binding Path}" Style="{StaticResource MutedTextStyle}" FontSize="11" MaxLines="1" TextTrimming="CharacterEllipsis" /></StackPanel></DataTemplate></ListView.ItemTemplate></ListView></Border>
                        <Border Grid.Column="1" Style="{StaticResource CardStyle}" Padding="0"><Grid><Grid.RowDefinitions><RowDefinition Height="54" /><RowDefinition Height="*" /><RowDefinition Height="44" /></Grid.RowDefinitions><Grid Padding="16,0"><TextBlock x:Name="EditorFileName" Text="选择配置文件" FontWeight="SemiBold" VerticalAlignment="Center" /><Button Content="检查语法" HorizontalAlignment="Right" VerticalAlignment="Center" Click="Validate_Click" /></Grid><TextBox x:Name="SourceEditor" Grid.Row="1" FontFamily="Consolas" FontSize="13" AcceptsReturn="True" TextWrapping="NoWrap" ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Auto" TextChanged="SourceEditor_TextChanged" /><Border Grid.Row="2" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,1,0,0" Padding="14,0"><TextBlock x:Name="EditorStatus" Text="就绪" Style="{StaticResource MutedTextStyle}" VerticalAlignment="Center" /></Border></Grid></Border>
                    </Grid>

                    <Grid x:Name="BackupsPage" Visibility="Collapsed">
                        <Border Style="{StaticResource CardStyle}"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions><StackPanel Spacing="5" Margin="0,0,0,16"><TextBlock Text="自动备份" Style="{StaticResource SectionTitleStyle}" /><TextBlock Text="每次保存前都会完整备份原文件。" Style="{StaticResource MutedTextStyle}" /></StackPanel><ListView x:Name="BackupList" Grid.Row="1"><ListView.ItemTemplate><DataTemplate><Grid Padding="8" ColumnSpacing="16"><Grid.ColumnDefinitions><ColumnDefinition Width="190" /><ColumnDefinition Width="*" /><ColumnDefinition Width="100" /></Grid.ColumnDefinitions><TextBlock Text="{Binding CreatedAt}" /><TextBlock Grid.Column="1" Text="{Binding Path}" TextTrimming="CharacterEllipsis" /><TextBlock Grid.Column="2" Text="{Binding Size}" HorizontalAlignment="Right" /></Grid></DataTemplate></ListView.ItemTemplate></ListView></Grid></Border>
                    </Grid>
                </Grid>
            </Grid>
        </NavigationView>
    </Grid>
</Window>
