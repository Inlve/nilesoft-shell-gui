<Project>
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <VersionPrefix>0.2.1</VersionPrefix>
    <Authors>Shell Studio contributors</Authors>
    <Company>Shell Studio contributors</Company>
    <Product>Shell Studio</Product>
    <Description>A modern WinUI 3 manager for Nilesoft Shell configuration.</Description>
    <RepositoryUrl>https://github.com/Inlve/nilesoft-shell-gui</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <Deterministic>true</Deterministic>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <RestoreLockedMode Condition="'$(CI)' == 'true'">true</RestoreLockedMode>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
  </PropertyGroup>
</Project>
